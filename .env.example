PORT=3000
NODE_ENV=development

# Frontend base URL (used for CORS in dev; ignored when CORS_ORIGINS is set)
FRONTEND_URL=http://localhost:3001

# Allowed browser origins for credentialed CORS (comma-separated).
# Falls back to FRONTEND_URL when unset. Required in production.
# CORS_ORIGINS=http://localhost:3001,https://app.example.com

# PostgreSQL — individual connection vars (DATABASE_URL is NOT supported)
DATABASE_DRIVER=postgres
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=secret
DATABASE_DATABASE=nestjs_template_db
# Run pending migrations automatically on boot (default: true)
# DATABASE_MIGRATIONS_RUN=true
# Never set to true in production — dev/test convenience only
# DATABASE_SYNCHRONIZE=false

# Sentry (optional — SDK disabled when SENTRY_DSN is unset)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=1.0
SENTRY_PROFILE_SESSION_SAMPLE_RATE=1.0

# Kafka — domain event forwarding + the nodes bridge (opt-in; app boots without a broker when disabled)
KAFKA_ENABLED=false
# Comma-separated broker list — required when KAFKA_ENABLED=true
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=gardenia-bridge
# Domain-event topics are ${KAFKA_TOPIC_PREFIX}.${module}, e.g. gardenia-bridge.plants
KAFKA_TOPIC_PREFIX=gardenia-bridge
KAFKA_SSL=false
# SASL is optional — set username + password to enable
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=

# nodes bridge — Kafka topics (node -> Kafka telemetry/heartbeat/command-acks,
# Kafka -> node commands). Defaults derive from KAFKA_TOPIC_PREFIX above.
# KAFKA_BRIDGE_TELEMETRY_TOPIC=gardenia-bridge.telemetry
# KAFKA_BRIDGE_HEARTBEAT_TOPIC=gardenia-bridge.heartbeat
# KAFKA_BRIDGE_COMMAND_ACKS_TOPIC=gardenia-bridge.command-acks
# KAFKA_BRIDGE_COMMANDS_TOPIC=gardenia-bridge.commands

# nodes bridge — MQTT broker connection (Mosquitto in dev; any MQTT 3.1.1/5 broker elsewhere)
MQTT_URL=mqtt://localhost:1883
MQTT_CLIENT_ID=gardenia-bridge
# No node auth in v1 — leave unset (see openspec/changes/kafka-mqtt-bridge/design.md)
MQTT_USERNAME=
MQTT_PASSWORD=

# nodes bridge — local SQLite audit log of every message relayed (edge-deployment friendly)
BRIDGE_AUDIT_DB_PATH=./data/bridge-audit.sqlite

# Logging
LOG_LEVEL=info
